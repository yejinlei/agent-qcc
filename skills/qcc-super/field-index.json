  "routingAlgo": {
    "description": "自然语言→字段提取→倒排索引→server聚合→批量调用→最少MCP调用",
    "steps": [
      {
        "step": 1,
        "name": "字段提取",
        "action": "从自然语言中提取字段关键词，参照 fieldIndex 进行匹配",
        "priority": ["精确匹配", "同义词匹配", "模糊匹配"]
      },
      {
        "step": 2,
        "name": "批量工具优先",
        "action": "检查是否可被 batchTools 覆盖（get_company_risk_scan 替代 31 个工具）",
        "condition": "字段集 ⊆ batchTools[].coversFields"
      },
      {
        "step": 3,
        "name": "Server 聚合",
        "action": "按 server 分组，同 server 工具批量调用，最小化 server 连接数",
        "aggregation": "group_by(server, tools)"
      },
      {
        "step": 4,
        "name": "效率评估",
        "action": "计算 efficiency = coversFields / toolCalls，选择最优方案",
        "threshold": { "optimal": ">=5.0", "suboptimal": "3.0-5.0", "normal": "1.0-3.0" }
      }
    ],
    "examples": [
      {
        "input": "查一下注册资本、股东和专利",
        "fields": ["注册资本", "股东", "专利"],
        "mapping": {
          "qcc-company": ["get_company_registration_info", "get_shareholder_info"],
          "qcc-ipr": ["get_patent_info"]
        },
        "servers": 2,
        "tools": 3,
        "efficiency": 2.33
      },
      {
        "input": "查一下风险情况",
        "fields": ["风险"],
        "mapping": {
          "qcc-risk": ["get_company_risk_scan"]
        },
        "servers": 1,
        "tools": 1,
        "efficiency": 34.0,
        "note": "批量工具覆盖 34 类风险"
      },
      {
        "input": "查高管背景和失信",
        "fields": ["高管", "失信"],
        "mapping": {
          "qcc-executive": ["get_executive_risk_scan"]
        },
        "servers": 1,
        "tools": 1,
        "efficiency": 18.0,
        "note": "批量工具覆盖 18 项高管风险"
      }
    ]
  },

  "ontology": {
    "entities": {
      "Enterprise": {
        "properties": ["name","uscc","legal_rep","registered_capital","status","type","address","establishment_date","business_scope","shareholders","executives","investments","branches","risk_signals","financial_data","ipr_assets"]
      },
      "Person": {
        "properties": ["name","id_hash","roles","risk_flags","controlled_companies","affiliations"]
      },
      "Relationship": {
        "types": ["持股","控制","担保","关联交易","任职"]
      }
    },
    "riskRules": [
      {
        "id": "R1",
        "name": "直接风险",
        "condition": "risk_signals CONTAINS 失信/被执行/限高/股权冻结/经营异常",
        "conclusion": "risk_level = D (直接拒绝)",
        "fields": ["get_company_risk_scan"]
      },
      {
        "id": "R2",
        "name": "关联破产传导",
        "condition": "real_controller = P AND P.controls(B) AND B.status = 破产重整",
        "conclusion": "关联破产风险 = HIGH, risk_score += 0.3 × 控制权比例",
        "fields": ["get_actual_controller","get_executive_controlled_companies","get_bankruptcy_reorganization"]
      },
      {
        "id": "R3",
        "name": "壳公司识别",
        "condition": "法代变更≥3次(2y) AND 地址变更≥2次 AND 参保人数=0",
        "conclusion": "壳公司嫌疑 = TRUE, risk_level → D",
        "fields": ["get_historical_legal_rep","get_historical_registration","get_financial_data"]
      },
      {
        "id": "R4",
        "name": "股东风险传导",
        "condition": "shareholder 有失信/被执行 AND 持股≥20%",
        "conclusion": "股东风险传导 = TRUE, risk_score += 0.2 × 持股比例",
        "fields": ["get_shareholder_info","get_dishonest_people","get_judgment_debtor_info"]
      },
      {
        "id": "R5",
        "name": "股权冻结影响",
        "condition": "equity_freeze EXISTS",
        "conclusion": "股权质押风险 = HIGH, risk_score += 0.15 × 冻结占比",
        "fields": ["get_equity_freeze"]
      },
      {
        "id": "R6",
        "name": "高管一票否决",
        "condition": "person.risk_flags CONTAINS 失信/限高/限出境/股权冻结",
        "conclusion": "个人风险等级 = 一票否决",
        "fields": ["get_executive_risk_scan"]
      },
      {
        "id": "R7",
        "name": "系统性风险主体",
        "condition": "controls N companies AND M have 失信/被执行",
        "conclusion": "系统性风险 = TRUE, risk_score = (M/N)×100",
        "fields": ["get_executive_controlled_companies","get_executive_related_companies_risk"]
      },
      {
        "id": "R8",
        "name": "任职重叠风险",
        "condition": "executive at K enterprises AND any has 失信/经营异常",
        "conclusion": "关联风险传导 = TRUE",
        "fields": ["get_executive_position_history","get_company_risk_scan"]
      },
      {
        "id": "R9",
        "name": "控制力衰减",
        "condition": "持股<50% AND role != 法代",
        "conclusion": "控制力 = 弱, risk_score -= 0.1",
        "fields": ["get_actual_controller","get_shareholder_info"]
      },
      {
        "id": "R10",
        "name": "关联网络密度",
        "condition": "related_companies = M AND K have risk",
        "conclusion": "网络风险 = (K/M) × 密度系数",
        "fields": ["get_executive_controlled_companies","get_executive_related_companies_risk"]
      },
      {
        "id": "R11",
        "name": "担保传导",
        "condition": "guarantees(B) AND B.status = 破产/被执行",
        "conclusion": "担保传导风险 = HIGH",
        "fields": ["get_credit_guarantee","get_bankruptcy_reorganization","get_judgment_debtor_info"]
      },
      {
        "id": "R12",
        "name": "实控人变更预警",
        "condition": "法代变更≥2次(1y)",
        "conclusion": "控制权稳定性 = 低, risk_score += 0.15",
        "fields": ["get_historical_legal_rep"]
      }
    ]
  }
}
