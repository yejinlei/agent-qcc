# ---- LLM（任意 OpenAI 兼容端点）-------------------------------------------
# 留空 = 离线模式，走规则路由/规划/反思，不调用大模型
AGENT_QCC_OPENAI_API_KEY=
AGENT_QCC_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_QCC_MODEL_NAME=gpt-4o-mini
AGENT_QCC_LLM_TEMPERATURE=0.1

# ---- 企查查 Connector -------------------------------------------------------
AGENT_QCC_SKILL_NAME=qcc-company
AGENT_QCC_QCC_MCP_URL=https://agent.qcc.com/mcp/company/stream
AGENT_QCC_QCC_TIMEOUT=45.0
# 认证（可选）：留空则不携带认证头
AGENT_QCC_QCC_AUTH_TOKEN=
AGENT_QCC_QCC_AUTH_HEADER=Authorization
AGENT_QCC_QCC_AUTH_SCHEME=Bearer
# 重试：瞬时错误（5xx / 超时 / 连接失败）自动重试
AGENT_QCC_QCC_RETRIES=2
AGENT_QCC_QCC_BACKOFF=0.8

# ---- Pipeline ---------------------------------------------------------------
# true = 只演示 4R+1 编排，不真的打企查查（默认，便于本地跑通与 CI）
AGENT_QCC_OFFLINE=true
AGENT_QCC_USE_LLM=true
AGENT_QCC_MAX_REFLECT_RETRIES=1

# ---- Serve ------------------------------------------------------------------
# 留空 = 进程内 InMemorySaver；生产可换成 langgraph.checkpoint.postgres.PostgresSaver
AGENT_QCC_CHECKPOINTER=
